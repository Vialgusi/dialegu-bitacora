{
  "name": "dialegu-bitacora",
  "productName": "Dialegu Bitácora",
  "version": "0.3.0",
  "description": "Graba o carga encuentros, grupos focales y entrevistas; los transcribe por voces en tu propio equipo.",
  "author": "Dialegu",
  "private": true,
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5175 concurrently -k \"npm run dev\" \"wait-on tcp:5175 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "motor:build": "cd .. && venv\\Scripts\\python.exe -m PyInstaller Dialegu_Engine.spec --noconfirm --distpath backend-dist",
    "test": "node --test \"src/estado/*.test.js\""
  },
  "build": {
    "appId": "com.dialegu.bitacora",
    "productName": "Dialegu Bitácora",
    "directories": {
      "output": "../dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "../backend-dist/Dialegu_Engine",
        "to": "Dialegu_Engine"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dialegu Bitácora",
      "artifactName": "Dialegu-Bitacora-${version}-instalador.${ext}"
    }
  },
  "dependencies": {
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vialgusi/dialegu-bitacora"
  }
}
